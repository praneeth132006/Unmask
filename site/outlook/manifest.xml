<?xml version="1.0" encoding="UTF-8"?>
<!-- Unmask for Outlook: reads the open message and checks it in the task pane. Nothing is sent to any server. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>a4613c7d-30d9-4b44-af30-86438886502b</Id>
  <Version>0.7.0.0</Version>
  <ProviderName>Unmask contributors</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Unmask"/>
  <Description DefaultValue="See what a suspicious email is really hiding. Checks the sender, links and wording on your device."/>
  <IconUrl DefaultValue="https://praneeth132006.github.io/Unmask/media/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://praneeth132006.github.io/Unmask/media/icon-128.png"/>
  <SupportUrl DefaultValue="https://praneeth132006.github.io/Unmask/outlook.html"/>
  <AppDomains><AppDomain>https://praneeth132006.github.io</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.5"/></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead"><DesktopSettings><SourceLocation DefaultValue="https://praneeth132006.github.io/Unmask/outlook/taskpane.html"/><RequestedHeight>450</RequestedHeight></DesktopSettings></Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/></Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements><bt:Sets DefaultMinVersion="1.5"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="unmaskGroup"><Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="unmaskOpen"><Label resid="buttonLabel"/>
                    <Supertip><Title resid="buttonLabel"/><Description resid="buttonTip"/></Supertip>
                    <Icon><bt:Image size="16" resid="icon16"/><bt:Image size="32" resid="icon32"/><bt:Image size="80" resid="icon80"/></Icon>
                    <Action xsi:type="ShowTaskpane"><SourceLocation resid="taskpaneUrl"/></Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
          <MobileFormFactor>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="unmaskMobileGroup"><Label resid="groupLabel"/>
                <Control xsi:type="MobileButton" id="unmaskMobileOpen"><Label resid="buttonLabel"/>
                  <Icon xsi:type="bt:MobileIconList"><bt:Image size="25" scale="1" resid="icon32"/><bt:Image size="25" scale="2" resid="icon80"/><bt:Image size="25" scale="3" resid="icon80"/><bt:Image size="32" scale="1" resid="icon32"/><bt:Image size="32" scale="2" resid="icon80"/><bt:Image size="32" scale="3" resid="icon80"/><bt:Image size="48" scale="1" resid="icon80"/><bt:Image size="48" scale="2" resid="icon80"/><bt:Image size="48" scale="3" resid="icon80"/></Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="taskpaneUrl"/></Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://praneeth132006.github.io/Unmask/icon-48.png"/>
          <bt:Image id="icon32" DefaultValue="https://praneeth132006.github.io/Unmask/icon-48.png"/>
          <bt:Image id="icon80" DefaultValue="https://praneeth132006.github.io/Unmask/media/icon-128.png"/>
        </bt:Images>
        <bt:Urls><bt:Url id="taskpaneUrl" DefaultValue="https://praneeth132006.github.io/Unmask/outlook/taskpane.html"/></bt:Urls>
        <bt:ShortStrings><bt:String id="groupLabel" DefaultValue="Unmask"/><bt:String id="buttonLabel" DefaultValue="Check with Unmask"/></bt:ShortStrings>
        <bt:LongStrings><bt:String id="buttonTip" DefaultValue="See what this email is really hiding. Checked on your device."/></bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
