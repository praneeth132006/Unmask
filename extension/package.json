{
  "name": "unmask-extension",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "See what a suspicious email is really hiding.",
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/third-party-licenses.mjs && wxt build",
    "zip": "node scripts/third-party-licenses.mjs && wxt zip",
    "postinstall": "wxt prepare",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/run.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "build:e2e": "UNMASK_E2E=1 wxt build"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "postal-mime": "^4.0.11",
    "punycode": "^2.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/punycode": "^2.1.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.3",
    "playwright": "1.62.1",
    "qrcode": "1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/praneeth132006/Unmask.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/praneeth132006/Unmask#readme",
  "bugs": {
    "url": "https://github.com/praneeth132006/Unmask/issues"
  }
}
