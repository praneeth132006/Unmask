{
  "name": "unmask",
  "private": true,
  "description": "Browser extension that shows what a suspicious email is really hiding.",
  "scripts": {
    "dev": "pnpm --filter unmask-extension dev",
    "build": "pnpm --filter unmask-extension build",
    "build:firefox": "pnpm --filter unmask-extension build:firefox",
    "build:edge": "pnpm --filter unmask-extension build:edge",
    "zip": "pnpm --filter unmask-extension zip",
    "zip:all": "pnpm --filter unmask-extension zip:all",
    "backend": "pnpm --filter unmask-backend dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter unmask-extension build:e2e && pnpm --filter unmask-extension test:e2e",
    "site": "node site/build.mjs",
    "wiki": "node site/wiki.mjs",
    "ci:local": "sh scripts/ci-local.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/praneeth132006/Unmask.git"
  },
  "homepage": "https://github.com/praneeth132006/Unmask#readme",
  "bugs": {
    "url": "https://github.com/praneeth132006/Unmask/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "marked": "^18.1.1"
  },
  "pnpm": {
    "overrides": {
      "nodemailer": "10.1.7",
      "undici": "8.12.2"
    }
  }
}
